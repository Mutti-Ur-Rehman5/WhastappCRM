{
  "name": "appointment-agent",
  "version": "0.1.0",
  "description": "AI WhatsApp appointment agent for a doctor's clinic (MERN, plain JavaScript)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-all.js --watch",
    "start": "node scripts/start-all.js",
    "dev:server": "node --watch server.js",
    "dev:worker": "node --watch workers/worker.js",
    "start:server": "node server.js",
    "worker": "node --watch workers/worker.js",
    "start:worker": "node workers/worker.js",
    "seed:config": "node scripts/seedDoctorConfig.js",
    "test": "node --env-file=.env.test --test \"tests/unit/*.test.js\" && node --env-file=.env.test --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:unit": "node --env-file=.env.test --test \"tests/unit/*.test.js\"",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:load": "node --env-file=.env.test --test --test-concurrency=1 \"tests/integration/load/*.test.js\"",
    "test:chaos": "node --env-file=.env.test --test --test-concurrency=1 \"tests/integration/chaos/*.test.js\"",
    "test:reschedule-confirmation": "node --env-file=.env.test --test --test-concurrency=1 \"tests/integration/reschedule-confirmation.test.js\"",
    "test:live": "node --env-file=.env --test \"tests/integration/live/*.test.js\"",
    "test:nlu-eval": "node --env-file=.env --test \"tests/integration/nlu-eval/*.test.js\"",
    "eval:nlu": "node --env-file=.env tests/integration/nlu-eval/run.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@googleapis/sheets": "^13.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "opossum": "^10.0.0",
    "redlock": "^5.0.0-beta.2",
    "winston": "^3.17.0"
  }
}
